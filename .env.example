# Supabase configuration
# Public keys (can be included in client-side code)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Private keys (server-side only - NEVER expose these in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Database (for direct connection if needed)
# Replace password with your actual database password - never hardcode in code
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/training_platform

# Initial admin user credentials (used only during setup)
INITIAL_ADMIN_PASSWORD=strong_password_here
# To use the specified password: ThreeandSeven3&7

# Application settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email service (if needed)
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# Security settings
# JWT secret key for token signing (32+ random characters)
JWT_SECRET=generate_a_long_random_string_here
# Cookie secret for session encryption
COOKIE_SECRET=generate_another_long_random_string_here

# FastAPI backend settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/training_platform
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
ENVIRONMENT=development
PORT=8000

# Next.js frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REDIS_URL=redis://localhost:6379

# Email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@3and7.example.com

# OAuth2 settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Logging settings
LOG_LEVEL=INFO

# PostgreSQL Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=training_db

# Redis Variables
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Environment Variables
REDIS_URL=redis://localhost:6379 