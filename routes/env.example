# Supabase configuration
# Public keys (can be included in client-side code)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Private keys (server-side only - NEVER expose these in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Database (for direct connection if needed)
# Replace password with your actual database password - never hardcode in code
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/training_platform

# Initial admin user credentials (used only during setup)
# Only used for initial setup. Change or remove after first use!
INITIAL_ADMIN_PASSWORD=strong_password_here
# To use the specified password: ThreeandSeven3&7

# Application settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email service (if needed)
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# Security settings
# JWT secret key for token signing (32+ random characters)
# JWT secret key for token signing (32+ random characters, use a secure generator)
# JWT secret key for token signing (32+ random characters, use a secure generator)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_32_CHAR_STRING # CHANGE THIS IN PRODUCTION
# Cookie secret for session encryption
# Cookie secret for session encryption (32+ random characters, use a secure generator)
# Cookie secret for session encryption (32+ random characters, use a secure generator)
COOKIE_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_32_CHAR_STRING # CHANGE THIS IN PRODUCTION

# FastAPI backend settings
# FastAPI secret key (32+ random characters, do not use default)
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
ENVIRONMENT=development
PORT=8000

# Next.js frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REDIS_URL=redis://localhost:6379

# Email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@3and7.example.com

# OAuth2 settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Logging settings
LOG_LEVEL=INFO

# PostgreSQL Variables
# Do NOT use default credentials in production!
# Do NOT use default credentials in production!
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme_strong_password # CHANGE THIS IN PRODUCTION
POSTGRES_DB=training_db

# Redis Variables
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Environment Variables
REDIS_URL=redis://localhost:6379 